{%- if s.image %}{{ m.media(s.image, 'media-bleed ' ~ side) }}{% endif %}
<div class="col-text">
  <div class="s-body">
    {{ m.head(s, lead=False) }}
    <div class="ilist">
      {%- for it in s['items'] %}
      <div class="row">{{ m.icon_badge(it.icon, it.title, s.item_stickers[loop.index0] if s.item_stickers else '') }}<div>{{ m.t(it.title, 'h3') }}{{ m.t(it.text) }}</div></div>
      {%- endfor %}
    </div>
  </div>
</div>
