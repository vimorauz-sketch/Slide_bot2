{{ m.head(s) }}
<div class="s-body">
  <div class="steps" style="--n:{{ s.steps|length }}">
    {%- for st in s.steps %}
    <div class="step">
      <div class="dot" data-t>{{ loop.index }}</div>
      <div class="step-card">{{ m.t(st.title, 'h3') }}{{ m.t(st.text) }}</div>
    </div>
    {%- endfor %}
  </div>
</div>
