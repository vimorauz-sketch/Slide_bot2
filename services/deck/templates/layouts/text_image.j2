{%- if s.image %}{{ m.media(s.image, 'media-bleed ' ~ side) }}{% endif %}
<div class="col-text">
  <div class="s-body">
    {{ m.head(s) }}
    {%- if s.bullets %}
    <ul class="bullets">
      {%- for b in s.bullets %}<li><span class="mk"></span><span class="t" data-t>{{ b|rich }}</span></li>{% endfor %}
    </ul>
    {%- endif %}
  </div>
</div>
