<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
{%- set g = t.layout -%}
{%- macro box(c) -%}content: ""; background: {{ c }};{%- endmacro -%}
<style>
{{ font_css|safe }}
:root {
  --ink: {{ p.ink }}; --accent: {{ p.accent }}; --accent2: {{ p.accent2 }}; --soft: {{ p.soft }};
  --font-title: {{ font_title|safe }}; --font-body: {{ font_body|safe }}; --font-topic: {{ (font_topic or font_title)|safe }}; --body-size: {{ body_size }};
}
@page { size: A4; margin: 20mm 15mm 20mm 30mm;
  @bottom-center { content: counter(page); font-family: var(--font-body); font-size: 11pt; color: var(--ink); }
  {% if running %}@top-right { content: "{{ running|safe }}"; font-family: var(--font-title); font-size: 8.5pt; color: var(--accent);
    letter-spacing: .06em; text-transform: uppercase; vertical-align: bottom; padding-bottom: 2mm;
    {% if t.page in ('none', 'rule_top', 'frame') %}border-bottom: .4pt solid var(--accent2);{% endif %} }{% endif %}
  {# ---- page decorations, drawn in the page margin boxes (they repeat on every inner page) #}
  {% if t.page == 'band_top' %}
  {% set bt = "linear-gradient(var(--accent) 0 6mm, var(--accent2) 6mm 7mm, transparent 7mm)" %}
  @top-left-corner { {{ box(bt) }} } @top-left { {{ box(bt) }} } @top-center { {{ box(bt) }} } @top-right-corner { {{ box(bt) }} }
  {% if not running %}@top-right { {{ box(bt) }} }{% else %}@top-right { background: {{ bt }}; }{% endif %}
  {% elif t.page == 'band_bottom' %}
  {% set bb = "linear-gradient(transparent calc(100% - 7mm), var(--accent2) calc(100% - 7mm) calc(100% - 6mm), var(--accent) calc(100% - 6mm))" %}
  @bottom-left-corner { {{ box(bb) }} } @bottom-left { {{ box(bb) }} } @bottom-right { {{ box(bb) }} } @bottom-right-corner { {{ box(bb) }} }
  @bottom-center { content: counter(page); background: {{ bb }}; }
  {% elif t.page == 'rule_top' %}
  {% set rt = "linear-gradient(transparent 13mm, var(--accent) 13mm 13.6mm, transparent 13.6mm)" %}
  @top-left-corner { {{ box(rt) }} } @top-left { {{ box(rt) }} } @top-center { {{ box(rt) }} } @top-right-corner { {{ box(rt) }} }
  {% elif t.page == 'side_line' %}
  {% set sl = "linear-gradient(90deg, transparent 20mm, var(--accent2) 20mm 20.6mm, transparent 20.6mm)" %}
  @left-top { {{ box(sl) }} } @left-middle { {{ box(sl) }} } @left-bottom { {{ box(sl) }} }
  {% elif t.page == 'side_band' %}
  {% set sb = "linear-gradient(90deg, var(--accent) 0 7mm, var(--accent2) 7mm 8mm, transparent 8mm)" %}
  @left-top { {{ box(sb) }} } @left-middle { {{ box(sb) }} } @left-bottom { {{ box(sb) }} }
  @top-left-corner { {{ box(sb) }} } @bottom-left-corner { {{ box(sb) }} }
  {% elif t.page == 'frame' %}
  {% set ft = "linear-gradient(transparent 10mm, var(--accent) 10mm 10.5mm, transparent 10.5mm)" %}
  {% set fb = "linear-gradient(transparent 9.5mm, var(--accent) 9.5mm 10mm, transparent 10mm)" %}
  {% set fl = "linear-gradient(90deg, transparent 12mm, var(--accent) 12mm 12.5mm, transparent 12.5mm)" %}
  {% set fr = "linear-gradient(90deg, transparent 4.5mm, var(--accent) 4.5mm 5mm, transparent 5mm)" %}
  @top-left { {{ box(ft) }} } @top-center { {{ box(ft) }} }
  @bottom-left { {{ box(fb) }} } @bottom-right { {{ box(fb) }} } @bottom-center { content: counter(page); background: {{ fb }}; }
  @left-top { {{ box(fl) }} } @left-middle { {{ box(fl) }} } @left-bottom { {{ box(fl) }} }
  @right-top { {{ box(fr) }} } @right-middle { {{ box(fr) }} } @right-bottom { {{ box(fr) }} }
  @top-left-corner { content: ""; background: linear-gradient(transparent 10mm, var(--accent) 10mm 10.5mm, transparent 10.5mm) no-repeat 12mm 0 / 100% 100%,
    linear-gradient(90deg, transparent 12mm, var(--accent) 12mm 12.5mm, transparent 12.5mm) no-repeat 0 10mm / 100% 100%; }
  @top-right-corner { content: ""; background: linear-gradient(transparent 10mm, var(--accent) 10mm 10.5mm, transparent 10.5mm) no-repeat -10mm 0 / 100% 100%,
    linear-gradient(90deg, transparent 4.5mm, var(--accent) 4.5mm 5mm, transparent 5mm) no-repeat 0 10mm / 100% 100%; }
  @bottom-left-corner { content: ""; background: linear-gradient(transparent 9.5mm, var(--accent) 9.5mm 10mm, transparent 10mm) no-repeat 12mm 0 / 100% 100%,
    linear-gradient(90deg, transparent 12mm, var(--accent) 12mm 12.5mm, transparent 12.5mm) no-repeat 0 -10mm / 100% 100%; }
  @bottom-right-corner { content: ""; background: linear-gradient(transparent 9.5mm, var(--accent) 9.5mm 10mm, transparent 10mm) no-repeat -10mm 0 / 100% 100%,
    linear-gradient(90deg, transparent 4.5mm, var(--accent) 4.5mm 5mm, transparent 5mm) no-repeat 0 -10mm / 100% 100%; }
  {% elif t.page == 'corners' %}
  @top-left-corner { content: ""; background: linear-gradient(var(--accent), var(--accent)) no-repeat 14mm 12mm / 12mm .8mm,
    linear-gradient(var(--accent), var(--accent)) no-repeat 14mm 12mm / .8mm 12mm; }
  @bottom-right-corner { content: ""; background: linear-gradient(var(--accent), var(--accent)) no-repeat calc(100% - 9mm) calc(100% - 12mm) / 12mm .8mm,
    linear-gradient(var(--accent), var(--accent)) no-repeat calc(100% - 9mm) calc(100% - 23.2mm) / .8mm 12mm; }
  {% endif %}
}
@page cover { margin: 0;
  @top-left-corner { content: none; } @top-left { content: none; } @top-center { content: none; } @top-right { content: none; }
  @top-right-corner { content: none; } @bottom-left-corner { content: none; } @bottom-left { content: none; }
  @bottom-center { content: none; } @bottom-right { content: none; } @bottom-right-corner { content: none; }
  @left-top { content: none; } @left-middle { content: none; } @left-bottom { content: none; }
  @right-top { content: none; } @right-middle { content: none; } @right-bottom { content: none; } }
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body { font-family: var(--font-body); font-size: var(--body-size); line-height: 1.5; color: var(--ink);
  -webkit-print-color-adjust: exact; print-color-adjust: exact; }

/* ------------------------------------------------------------ title page */
.cover { page: cover; position: relative; width: 210mm; height: 297mm; overflow: hidden; break-after: page; background: #fff; }
.cover .decor { position: absolute; inset: 0; width: 210mm; height: 297mm; }
.cover .photo { position: absolute; object-fit: cover; }
.ph-top { left: 0; top: 0; width: 210mm; height: 128mm; }
.ph-side { top: 0; width: 82mm; height: 297mm; {% if g.mirrored %}right: 0;{% else %}left: 0;{% endif %} }
.ph-bottom { left: 0; top: 170mm; width: 210mm; height: 127mm; }
.ph-circle { left: 59mm; top: 62mm; width: 92mm; height: 92mm; border-radius: 50%; }
.cover .photo-shade { position: absolute; left: 0; top: 0; width: 210mm; height: 128mm;
  background: linear-gradient(180deg, rgba(0,0,0,.45) 0%, rgba(0,0,0,0) 38%, rgba(0,0,0,0) 70%, rgba(0,0,0,.25) 100%); }
.cv { position: absolute; inset: 0; color: var(--ink); }
.cv .top, .cv .mid { position: absolute; }
.cv .ministry { font-family: var(--font-body); font-weight: 700; font-size: 11pt; line-height: 1.35; text-transform: uppercase; letter-spacing: .02em; }
.cv .inst { font-size: 12.5pt; font-weight: 700; margin-top: 4mm; line-height: 1.3; }
.cv .fac { font-size: 11.5pt; margin-top: 1.5mm; }
.cv .kind { font-family: var(--font-title); font-weight: 700; font-size: 36pt; letter-spacing: .14em; color: var(--accent); line-height: 1.1; }
.cv .subject { font-size: 13pt; margin-top: 7mm; }
.cv .subject b { color: var(--accent); }
.cv .topic-label { font-size: 12pt; margin-top: 6mm; color: var(--accent); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
.cv .topic { font-family: var(--font-topic); font-size: 19pt; font-weight: 700; line-height: 1.25; margin-top: 2mm; }
.cv .info { position: absolute; width: 86mm; font-size: 12.5pt; line-height: 1.6; }
.cv .info .row { display: flex; gap: 3mm; }
.cv .info .k { font-weight: 700; min-width: 26mm; color: var(--accent); }
.cv .city { position: absolute; font-size: 12.5pt; font-weight: 700; }
/* white text on dark pages */
.T-light .cv, .T-light .cv .kind, .T-light .cv .subject b, .T-light .cv .topic-label, .T-light .cv .info .k { color: #fff; }
.T-light .cv .topic-label, .T-light .cv .info .k { opacity: .85; }
.T-light .cv .kind { color: var(--accent2); }
.T-top_light .cv .top { color: #fff; }
.C-light .cv .city { color: #fff; }
/* layout specials */
.L-minimal .kind { font-size: 15pt; letter-spacing: .3em; }
.L-minimal .topic { font-size: 26pt; line-height: 1.15; margin-top: 4mm; }
.L-split .kind { font-size: 0; height: 0; }
.L-split .vkind { position: absolute; left: {{ 32 if g.mirrored else 178 }}mm; top: 148mm; transform: translate(-50%, -50%) rotate(-90deg);
  font-family: var(--font-title); font-weight: 700; font-size: 44pt; letter-spacing: .22em; color: #fff; white-space: nowrap; }
.L-magazine .kind { font-size: 64pt; letter-spacing: -.01em; line-height: .95; color: var(--ink); }
.L-magazine .topic { font-size: 24pt; line-height: 1.15; }
.L-chalk .cv { font-family: var(--font-title); }
.L-chalk .ministry { font-family: var(--font-body); }
.L-notebook .topic, .L-notebook .kind { font-family: var(--font-title); }
.L-band .kind, .L-book .kind, .L-stripes_v .kind, .L-timeline .kind, .L-side_photo .kind { letter-spacing: .06em; }
.L-card .kind { font-size: 30pt; }

/* ------------------------------------------------------------ inner pages */
.page-break { break-before: page; }
h1, h2, .plan-title { font-family: var(--font-title); color: var(--accent); break-after: avoid; }
h1 { font-size: 16pt; line-height: 1.3; margin: 0 0 6mm; }
h2 { font-size: 14pt; line-height: 1.35; margin: 6mm 0 3mm; }
p { margin: 0; text-indent: 12.5mm; text-align: justify; orphans: 2; widows: 2; }
.num { font-variant-numeric: lining-nums; }

/* heading styles */
h1 .n { display: none; }
.H-bar h1 { border-left: 1.6mm solid var(--accent); padding: 1mm 0 1mm 4mm; }
.H-bar h2 { border-left: .8mm solid var(--accent2); padding-left: 3mm; }
.H-underline h1 { border-bottom: .6mm solid var(--accent2); padding-bottom: 2mm; }
.H-underline h2 { text-decoration: underline; text-decoration-color: var(--accent2); text-underline-offset: 1.2mm; }
.H-caps h1 { text-align: center; text-transform: uppercase; color: var(--ink); letter-spacing: .03em; }
.H-caps h2 { color: var(--ink); }
.H-badge h1 { display: flex; align-items: center; gap: 4mm; }
.H-badge h1 .n { flex: none; width: 11mm; height: 11mm; border-radius: 50%; background: var(--accent); color: #fff;
  display: grid; place-items: center; font-size: 13pt; }
.H-badge h2 .n { color: var(--accent2); }
.H-box h1 { background: var(--soft); padding: 3mm 5mm; border-radius: 1.5mm; }
.H-box h2 { color: var(--accent); border-bottom: .3mm dashed var(--accent2); padding-bottom: 1mm; }
.H-rule h1 { display: flex; align-items: center; gap: 4mm; text-align: center; justify-content: center; }
.H-rule h1::before, .H-rule h1::after { content: ""; flex: 1; height: .35mm; background: var(--accent2); min-width: 8mm; }
.H-rule h1 span.t { flex: 0 1 auto; }
.H-pill h1 { display: inline-block; background: var(--accent); color: #fff; padding: 2mm 7mm; border-radius: 20mm; font-size: 14.5pt; }
.H-pill h2 { color: var(--accent); }
.H-pill h2 .n { background: var(--soft); border-radius: 3mm; padding: 0 2mm; }
.H-numbig h1 { display: flex; align-items: baseline; gap: 4mm; }
.H-numbig h1 .n { display: block; font-size: 30pt; line-height: 1; color: var(--accent2); }
.H-numbig h2 .n { color: var(--accent2); font-size: 15pt; }
.H-overline h1 { border-top: .9mm solid var(--accent); padding-top: 3mm; text-transform: uppercase; letter-spacing: .06em; font-size: 14.5pt; }
.H-overline h2 { font-variant: small-caps; letter-spacing: .03em; }
.H-marker h1 { display: table; background: linear-gradient(transparent 55%, color-mix(in srgb, var(--accent2) 45%, transparent) 55%); color: var(--ink); }
.H-marker h2 { color: var(--ink); background: linear-gradient(transparent 60%, color-mix(in srgb, var(--accent2) 30%, transparent) 60%); display: table; }
.H-block h1 { display: flex; align-items: stretch; gap: 0; }
.H-block h1 .n { display: flex; align-items: center; background: var(--accent); color: #fff; padding: 1.5mm 4mm; margin-right: 4mm; }
.H-block h1 .t { padding: 1.5mm 0; }
.H-block h2 .n { color: #fff; background: var(--accent2); padding: 0 1.8mm; }

/* plan */
.plan-title { text-align: center; font-size: 16pt; text-transform: uppercase; letter-spacing: .1em; margin-bottom: 8mm; }
.plan { list-style: none; padding: 0; margin: 0; }
.plan li { margin: 0 0 2.5mm; }
.plan li.sub { padding-left: 10mm; }
.plan li .pn { color: var(--accent); font-weight: 700; margin-right: 2mm; }

/* figures and tables */
figure { margin: 5mm 0; text-align: center; break-inside: avoid; }
figure img { max-width: 78%; max-height: 82mm; border-radius: 1.5mm; object-fit: cover; }
figcaption { font-size: 11.5pt; font-style: italic; margin-top: 2mm; color: var(--ink); text-indent: 0; }
figcaption b, .tcap b { color: var(--accent); font-style: normal; }
.tcap { text-align: right; font-size: 11.5pt; margin: 5mm 0 1.5mm; }
table { width: 100%; border-collapse: collapse; font-size: 12pt; line-height: 1.35; break-inside: avoid; }
th { background: var(--soft); color: var(--accent); text-align: left; }
th, td { border: .3mm solid color-mix(in srgb, var(--accent2) 55%, #fff); padding: 1.8mm 2.5mm; vertical-align: top; }
ol.refs { margin: 0; padding-left: 8mm; }
ol.refs li { margin-bottom: 2mm; text-align: justify; }
</style>
</head>
<body class="H-{{ t.heading }}">

<section class="cover L-{{ t.cover }} T-{{ g.tone }}{% if g.city_tone == 'light' %} C-light{% endif %}">
  {% if g.photo and cover_photo %}<img class="photo ph-{{ g.photo }}" src="{{ cover_photo }}">{% if g.photo == 'top' %}<div class="photo-shade"></div>{% endif %}{% endif %}
  {{ decor | safe }}
  <div class="cv">
    <div class="top" style="left:{{ g.left }}mm;right:{{ g.right }}mm;top:{{ g.top }}mm;text-align:{{ g.align }}">
      {% if m.ministry %}<div class="ministry">{{ m.ministry }}</div>{% endif %}
      {% if m.institution %}<div class="inst">{{ m.institution }}</div>{% endif %}
      {% if m.faculty %}<div class="fac">{{ m.faculty }}</div>{% endif %}
    </div>
    <div class="mid" style="left:{{ g.left }}mm;right:{{ g.right }}mm;top:{{ g.mid }}mm;text-align:{{ g.align }}">
      <div class="kind">{{ m.kind }}</div>
      {% if m.subject %}<div class="subject">{{ L.subject }}: <b>{{ m.subject }}</b></div>{% endif %}
      <div class="topic-label">{{ L.topic }}:</div>
      <div class="topic">«{{ m.topic }}»</div>
    </div>
    {% if t.cover == 'split' %}<div class="vkind">{{ m.kind }}</div>{% endif %}
    <div class="info" style="left:{{ g.info_left }}mm;top:{{ g.info }}mm">
      {% if m.author %}<div class="row"><span class="k">{{ L.author }}:</span><span>{{ m.author }}</span></div>{% endif %}
      {% if m.group %}<div class="row"><span class="k">{{ m.group_label or L.group }}:</span><span>{{ m.group }}</span></div>{% endif %}
      {% if m.teacher %}<div class="row"><span class="k">{{ L.teacher }}:</span><span>{{ m.teacher }}</span></div>{% endif %}
    </div>
    <div class="city" style="{% if g.align == 'left' %}left:{{ g.left }}mm;right:{{ g.right }}mm{% else %}left:0;right:0{% endif %};bottom:{{ g.city }}mm;text-align:{{ g.align }}">{{ m.city }}{% if m.city and m.year %} – {% endif %}{{ m.year }}</div>
  </div>
</section>

<section>
  <div class="plan-title">{{ L.plan }}</div>
  <ul class="plan">
    {% for s in sections %}
      <li><span class="pn">{{ s.number }}</span>{{ s.title }}</li>
      {% for sub in s.subsections %}<li class="sub"><span class="pn">{{ sub.number }}</span>{{ sub.title }}</li>{% endfor %}
    {% endfor %}
    <li><span class="pn"></span>{{ L.references }}</li>
  </ul>
</section>

{% set numbered_h1 = t.heading in ('badge', 'numbig', 'block') %}
{% for s in sections %}
<section class="page-break">
  <h1>{% if s.number %}<span class="n">{{ s.number|replace('.', '') }}</span>{% endif %}<span class="t">{% if s.number and not numbered_h1 %}{{ s.number }} {% endif %}{{ s.title_display }}</span></h1>
  {% for para in s.paragraphs %}<p>{{ para }}</p>{% endfor %}
  {% for sub in s.subsections %}
    <h2><span class="n">{{ sub.number }}</span> {{ sub.title }}</h2>
    {% for para in sub.paragraphs %}<p>{{ para }}</p>{% endfor %}
    {% if sub.image and sub.image.src %}
      <figure><img src="{{ sub.image.src }}"><figcaption><b>{{ sub.image.n }}-{{ L.figure }}.</b> {{ sub.image.caption }}</figcaption></figure>
    {% endif %}
    {% if sub.table %}
      <div class="tcap"><b>{{ sub.table.n }}-{{ L.table }}.</b> {{ sub.table.caption }}</div>
      <table><thead><tr>{% for h in sub.table.head %}<th>{{ h }}</th>{% endfor %}</tr></thead>
      <tbody>{% for r in sub.table.rows %}<tr>{% for c in r %}<td>{{ c }}</td>{% endfor %}</tr>{% endfor %}</tbody></table>
    {% endif %}
  {% endfor %}
  {% if s.image and s.image.src %}
    <figure><img src="{{ s.image.src }}"><figcaption><b>{{ s.image.n }}-{{ L.figure }}.</b> {{ s.image.caption }}</figcaption></figure>
  {% endif %}
</section>
{% endfor %}

<section class="page-break">
  <h1><span class="t">{{ L.references }}</span></h1>
  <ol class="refs">{% for r in references %}<li>{{ r }}</li>{% endfor %}</ol>
</section>
</body>
</html>
