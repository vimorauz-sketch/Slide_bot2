# SlideLab Telegram Bot Configuration
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
ADMIN_IDS=YOUR_ADMIN_TELEGRAM_ID

# Database URL (SQLite)
DATABASE_URL=sqlite+aiosqlite:///slidelab.db

# OpenAI API Key (content generation & vision/OCR)
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-5.6-sol
OPENAI_VISION_MODEL=gpt-5.6-sol

# Slide pictures. Providers without a key are skipped; if nothing is found the theme's own
# generated illustration is used, so slides are never empty.
IMAGE_PROVIDERS=pexels,unsplash,wikimedia,openai
PIXABAY_API_KEY=           # free: https://pixabay.com/api/docs/ (sign in, the key is shown there)
PEXELS_API_KEY=            # free: https://www.pexels.com/api/
UNSPLASH_ACCESS_KEY=       # free: https://unsplash.com/developers
WIKIMEDIA_ENABLED=true     # no key; good for science / history pictures
AI_IMAGES_ENABLED=false    # OpenAI image generation (paid per image)
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium

# Payment Environment ("DEMO" or "PRODUCTION")
# Only switch to PRODUCTION once CLICK_* / PAYME_* below are filled in AND the
# webhook server (bot/webhook_app.py) is reachable over HTTPS from the internet.
PAYMENT_ENV=DEMO

# Click Shop API merchant credentials (https://merchant.click.uz)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# Payme Merchant API credentials (https://business.payme.uz)
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# Local bind address/port for the payment webhook HTTP server. Put this behind an
# HTTPS reverse proxy (nginx + certbot) in production; Click/Payme require HTTPS.
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# Monetization Settings
DEFAULT_PRICE_PER_SLIDE=350
MIN_SLIDES_PER_ORDER=5
MAX_SLIDES_PER_ORDER=30
DEFAULT_LANGUAGE=uz

# Template gallery Mini App: the public HTTPS address of /webapp/ on this bot's server, e.g.
#   WEBAPP_URL=https://bot.your-real-domain.uz/webapp/
# Leave EMPTY if you have no HTTPS domain yet - templates are then chosen with inline buttons.
WEBAPP_URL=

# Flood protection: messages/presses a user may send at once, then per second; flooders are ignored
THROTTLE_BURST=12
THROTTLE_RATE=1
THROTTLE_BAN_SECONDS=300
# Presentations built at the same time (others wait in a queue) and free previews per user per day
MAX_PARALLEL_BUILDS=2
MAX_PREVIEWS_PER_DAY=3

# Speed: slides are written with a fast model thinking briefly (empty = use OPENAI_MODEL)
OPENAI_FAST_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
AI_PARALLEL_REQUESTS=10

# Database: on Railway add PostgreSQL and set DATABASE_URL=${{Postgres.DATABASE_URL}} (SQLite is wiped on every deploy)
# DATABASE_URL=postgresql://user:password@host:5432/railway

# TezCheck payments (https://tezcheck.uz): customers pay with Click or Payme
TEZCHECK_API_KEY=            # cabinet -> API key (aps_...)
TEZCHECK_CASH_DESK_CODE=     # cabinet -> cash desk code (cdk_...)
TEZCHECK_WEBHOOK_SECRET=     # shown once when you add the webhook https://<domain>/payments/tezcheck/webhook
TEZCHECK_SIGN_REQUESTS=false # true if the key accepts only signed requests
TEZCHECK_ACCEPT_TEST=false   # true only while testing with TezCheck's Test provider

# Admin dashboard: https://<domain>/admin (bot command /admin gives a one-time login link)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=              # empty = only the /admin link works
ADMIN_SECRET=                # random long text; signs dashboard sessions

# Testing only: without a payment system "To'lovni tasdiqlash" would give files for free.
# Keep false in production (without TezCheck new presentations are then closed automatically).
ALLOW_DEMO_PAYMENTS=false
